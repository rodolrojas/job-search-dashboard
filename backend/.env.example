FLASK_PORT=5000
FRONTEND_ORIGINS=http://localhost:3000

# PostgreSQL. Docker Compose overrides DB_HOST to the postgres service name.
POSTGRES_DB=role_radar
POSTGRES_USER=role_radar
POSTGRES_PASSWORD=role_radar_dev
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL=postgresql+psycopg://role_radar:role_radar_dev@localhost:5432/role_radar

CODEX_CLI_PATH=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=600
CODEX_WORKSPACE=

# Docker backend mode:
# 1. Set a long random CODEX_BRIDGE_TOKEN.
# 2. Set CODEX_BRIDGE_URL=http://host.docker.internal:8765 for the backend container.
# 3. Start codex_bridge.py on the host from the backend virtualenv.
CODEX_BRIDGE_URL=
CODEX_BRIDGE_TOKEN=replace-with-a-long-random-secret
CODEX_BRIDGE_HOST=0.0.0.0
CODEX_BRIDGE_PORT=8765

AGENT_MAX_SEARCH_QUERIES=4
AGENT_MAX_RESULTS=15
