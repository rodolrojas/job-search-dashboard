FLASK_PORT=5000
FRONTEND_ORIGINS=http://localhost:3000
CODEX_CLI_PATH=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=600
CODEX_WORKSPACE=

# Docker backend mode: run codex_bridge.py on the host and share this token.
CODEX_BRIDGE_URL=
CODEX_BRIDGE_TOKEN=replace-with-a-long-random-secret
CODEX_BRIDGE_HOST=0.0.0.0
CODEX_BRIDGE_PORT=8765

# Optional: only used for AI-generated cover letters. The job-search agent uses Codex CLI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
AGENT_MAX_SEARCH_QUERIES=4
AGENT_MAX_RESULTS=15
